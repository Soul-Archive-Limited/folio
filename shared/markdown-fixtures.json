        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "text": "A ",
                "styles": []
              },
              {
                "text": "bold",
                "styles": [
                  "bold"
                ]
              },
              {
                "text": " word",
                "styles": []
              }
            ]
          }
        ]
      }
    },
    {
