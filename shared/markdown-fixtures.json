  "lenient": [
    {
      "name": "asterisk italic is read as italic",
      "markdown": "an *old* style",
      "document": {
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "text": "an ",
                "styles": []
              },
              {
                "text": "old",
                "styles": [
                  "italic"
                ]
              },
              {
                "text": " style",
                "styles": []
              }
            ]
          }
        ]
      },
      "serialized": "an _old_ style"
