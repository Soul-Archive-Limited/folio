{
  "$comment": "Folio Markdown round-trip fixtures (SPEC §5.1). 'canonical' cases must parse to 'document' AND serialise back to exactly 'markdown'. 'lenient' cases parse 'markdown' to 'document' and serialise to 'serialized'. Used by iOS (MarkdownCodecTests) and the web editor.",
  "version": 1,
  "canonical": [
    {
      "name": "plain text",
      "markdown": "Hello world",
      "document": {
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "text": "Hello world",
                "styles": []
              }
            ]
          }
        ]
      }
    },
    {
      "name": "bold",
      "markdown": "A **bold** word",
