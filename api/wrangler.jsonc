// Folio API (SPEC §10.1). No secrets here: they live in Cloudflare's secret store
// (`npx wrangler secret put NAME`) and, for local dev only, in the git-ignored .dev.vars.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio-api",
  // Admin@devilsense.com's Account (owns the devilsense.com zone). Not a secret.
  "account_id": "8a423f60aa5b78df5763a9877746b80e",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "folio.devilsense.com/api/*", "zone_name": "devilsense.com" }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "folio-db", "database_id": "6638e1bb-37cb-4871-b5c4-7b1447f6116b", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "folio-blobs" }],
  "durable_objects": { "bindings": [{ "name": "USER_HUB", "class_name": "UserHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }],
  // Per-minute burst guard per user/IP (one Cloudflare location). Longer windows (per 15 min,
  // hour, day — SPEC §10.7) are D1 counters in `rate_limits`.
  "ratelimits": [{ "name": "BURST", "namespace_id": "4401", "simple": { "limit": 120, "period": 60 } }],
  "vars": {
    "APP_ORIGIN": "https://folio.devilsense.com",
    "APPLE_BUNDLE_ID": "com.devilsense.folio",
    "APPLE_SERVICES_ID": "com.devilsense.folio.web",
    "APPLE_TEAM_ID": "25DH3LUCPC",
    "APPLE_KEY_ID": "RVW7TN9U67",
    "GOOGLE_CLIENT_ID": "1035938398089-qgeb7hols8h1onoojsr7e7t4no9hut0g.apps.googleusercontent.com",
    "EMAIL_FROM": "Folio <no-reply@folio.devilsense.com>",
    "REVIEW_EMAIL": "review@devilsense.com",
    "REVIEW_ENABLED": "true"
  },
  // Nightly clean-up of expired rows (D1 size is the free plan's tightest limit).
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": true } }
}
