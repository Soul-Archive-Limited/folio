  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.1",
    "@cloudflare/workers-types": "5.20261013.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
