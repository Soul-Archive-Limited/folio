{
  "name": "folio-api",
  "version": "0.1.0",
  "private": true,
  "description": "Folio's API: one Cloudflare Worker with D1, R2 and the UserHub Durable Object (SPEC §10).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
