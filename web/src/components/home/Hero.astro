---
import Shot from '../Shot.astro';
import { account, storeCta } from '../../config/site';
const store = storeCta();
const words = ['Your', 'days,'];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-aura" aria-hidden="true">
    <i></i><i></i><i></i>
    <canvas class="aura-gl" data-aura></canvas>
  </div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="caption eyebrow">A calendar diary for iPhone and the web</p>
      <h1 id="hero-title" class="serif">
        {words.map((w, i) => <><span class="w" style={`--i:${i}`}>{w}</span>{' '}</>)}<em class="w" style="--i:2">kept.</em>
      </h1>
      <p class="lede">Write about today, or any day back to 1900. Your words, photos and tasks land on one calendar — encrypted so only you can read them.</p>
      <div class="ctas">
        <a class="btn btn-primary" href={account.getStarted}>Get started <span class="arrow" aria-hidden="true">→</span></a>
        {store && <a class="btn btn-glass" href={store.href} rel="noopener">{store.label}</a>}
        <a class="btn btn-quiet" href="#day">See how it works</a>
      </div>
      <p class="fine">Free. No account needed on iPhone. No ads, no tracking.</p>
    </div>
    <div class="hero-stage" data-phone3d>
      <div class="hero-poster">
        <Shot name="calendar-today" eager width={300}
          alt="Folio on iPhone: October 2026 with small photos on the days written about, coloured dots and task rings, and Tuesday 27 October's page below." />
      </div>
      <div class="hero-floor" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding: clamp(28px, 6vw, 72px) 0 clamp(48px, 8vw, 96px); isolation: isolate; }
  .hero-aura { position: absolute; inset: -140px 0 -10%; z-index: -1; pointer-events: none; overflow: hidden; -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent); mask-image: linear-gradient(to bottom, #000 62%, transparent); }
  .hero-aura i { position: absolute; border-radius: 50%; filter: blur(70px); opacity: 0.7; }
  .hero-aura i:nth-child(1) { width: 46vw; height: 46vw; right: 6%; top: 8%; background: var(--aura1); }
  .hero-aura i:nth-child(2) { width: 34vw; height: 34vw; right: -6%; top: 40%; background: var(--aura2); }
  .hero-aura i:nth-child(3) { width: 38vw; height: 38vw; left: -10%; top: 50%; background: var(--aura3); opacity: 0.45; }
  .aura-gl { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s ease; }
  .aura-gl.is-on { opacity: 1; }
  @media (prefers-color-scheme: dark) { .hero-aura i { opacity: 0.22; } .hero-aura i:nth-child(3) { opacity: 0.16; } }

  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); align-items: center; gap: clamp(24px, 4vw, 56px); }
  .eyebrow { margin: 0 0 20px; }
  h1 { font-size: clamp(76px, 10.4vw, 148px); line-height: 0.88; letter-spacing: -0.035em; margin: 0 0 28px; }
  h1 em { font-style: italic; color: var(--ember-text); padding-right: 0.06em; }
  .w { display: inline-block; }
  .lede { font-size: clamp(18px, 1.9vw, 21px); line-height: 1.5; color: var(--text-2); max-width: 34ch; margin-bottom: 32px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-left: -2px; }
  .fine { margin: 18px 0 0; font-size: 14px; color: var(--text-2); }

  .hero-stage { position: relative; height: clamp(520px, 52vw, 700px); display: grid; place-items: center; }
  .hero-poster { perspective: 1800px; transition: opacity 600ms ease, filter 600ms ease; }
  .hero-poster .phone { transform: rotateY(-16deg) rotateX(5deg) rotateZ(2deg); box-shadow: 0 0 0 1.5px #3a3a40 inset, 0 60px 90px -40px rgb(60 30 10 / 0.45); }
  .hero-stage :global(canvas) { position: absolute !important; inset: 0; opacity: 0; transition: opacity 700ms ease; }
  .hero-stage.is-3d :global(canvas) { opacity: 1; }
  .hero-stage.is-3d .hero-poster { opacity: 0; filter: blur(6px); }
  .hero-floor { position: absolute; bottom: 4%; left: 50%; width: 52%; height: 28px; translate: -50% 0; border-radius: 50%; background: radial-gradient(closest-side, rgb(60 30 10 / 0.22), transparent); transition: opacity 600ms ease; }
  .hero-stage.is-3d .hero-floor { opacity: 0; }

  /* Load: the headline sharpens word by word, like the app's greeting (SPEC §4.2); the phone rises. */
  @media (prefers-reduced-motion: no-preference) {
    .w { animation: word-in 900ms var(--ease) both; animation-delay: calc(80ms + var(--i) * 70ms); }
    .hero-poster .phone { animation: phone-in 1200ms var(--ease) both 120ms; }
  }
  @keyframes word-in { from { transform: translateY(0.18em); filter: blur(12px); } }
  @keyframes phone-in { from { transform: translateY(40px) rotateY(-26deg) rotateX(10deg) rotateZ(4deg); } }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-stage { height: clamp(460px, 120vw, 600px); margin-top: 8px; }
    .hero-poster .phone { --phone-w: 250px !important; }
  }
</style>
