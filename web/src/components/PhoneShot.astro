---
/** A real Folio screenshot in a slim iPhone frame, with the dark-mode shot when there is one. */
interface Props { name: string; alt: string; dark?: boolean }
const { name, alt, dark = false } = Astro.props;
---
<figure class="shot">
  <picture>
    {dark && <source srcset={`/img/${name}-dark.webp`} media="(prefers-color-scheme: dark)" />}
    <img src={`/img/${name}-light.webp`} alt={alt} width="552" height="1200" loading="lazy" decoding="async" />
  </picture>
</figure>
<style>
  .shot { margin: 0; width: min(280px, 70vw); padding: 8px; border-radius: 46px; background: #1b1b1f; box-shadow: 0 0 0 1.5px #3a3a40 inset, 0 40px 70px -34px rgb(40 20 10 / 0.4); }
  .shot img { border-radius: 38px; width: 100%; }
</style>
