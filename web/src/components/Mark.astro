---
/** The Folio mark: a page with an ember dot (SPEC §3.10). Decorative. */
---
<svg viewBox="0 0 72 72" aria-hidden="true" class="mark">
  <rect x="13" y="6" width="46" height="60" rx="9" fill="var(--ink)" />
  <rect x="21" y="29" width="30" height="3" rx="1.5" fill="var(--bg)" opacity="0.35" />
  <rect x="21" y="37" width="34" height="3" rx="1.5" fill="var(--bg)" opacity="0.35" />
  <rect x="21" y="45" width="25" height="3" rx="1.5" fill="var(--bg)" opacity="0.35" />
  <circle cx="55" cy="12" r="8" fill="var(--ember)" />
</svg>
