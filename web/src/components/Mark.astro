---
/** The Folio mark (Batch K): an open diary whose gutter is a fountain-pen nib, on an Ink tile.
 *  Paths come from scripts/brand/generate.py. Decorative. */
import { MARK_PATHS, NIB_PATH, NIB_TRANSFORM, TILE } from './brand-mark.ts';
const id = `folio-ink-${Math.random().toString(36).slice(2, 8)}`;
---
<svg viewBox="0 0 100 100" aria-hidden="true" class="mark">
  <defs><linearGradient id={id} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color={TILE.top} /><stop offset="1" stop-color={TILE.bottom} /></linearGradient></defs>
  <rect width="100" height="100" rx="22.5" fill={`url(#${id})`} />
  {MARK_PATHS.map((d) => <path d={d} fill={TILE.paper} />)}
  <path transform={NIB_TRANSFORM} d={NIB_PATH} fill={TILE.paper} fill-rule="evenodd" />
</svg>
