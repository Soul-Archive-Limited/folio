---
/** One of Folio's own icons (Batch K, the iPhone's custom symbols) as inline SVG. Decorative. */
import { FOLIO_ICONS, type FolioIconName } from '../icons/folio-icons';
interface Props { name: FolioIconName; size?: number }
const { name, size = 24 } = Astro.props;
---
<svg class="folio-icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true"><path d={FOLIO_ICONS[name]} fill="currentColor" /></svg>
