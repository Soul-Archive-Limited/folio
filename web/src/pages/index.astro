---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import DayStory from '../components/home/DayStory.astro';
import ReadYourMonth from '../components/home/ReadYourMonth.astro';
import Screens from '../components/home/Screens.astro';
import MakeItYours from '../components/home/MakeItYours.astro';
import PrivacyBand from '../components/home/PrivacyBand.astro';
import Everywhere from '../components/home/Everywhere.astro';
import Closing from '../components/home/Closing.astro';
---
<Base title="Folio" og="home" description="A private calendar diary for iPhone and the web. Write for any day, keep photos and tasks on the same calendar — encrypted so only you can read it.">
  <link slot="head" rel="preload" as="image" href="/img/app/calendar-today-light.webp" media="(prefers-color-scheme: light)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/img/app/calendar-today-dark.webp" media="(prefers-color-scheme: dark)" fetchpriority="high" />
  <Hero />
  <ReadYourMonth />
  <DayStory />
  <Screens />
  <PrivacyBand />
  <MakeItYours />
  <Everywhere />
  <Closing />
</Base>

<script>
  import '../scripts/home.ts';
</script>
