---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../config/site';
const wont = ['Show ads', 'Sell, analyse or train anything on your writing', 'Add streaks, badges or guilt', 'Turn your diary into a feed'];
---
<Base title="About" og="about" description="Why Folio exists: a private diary built around a calendar, made by Soul Archive Ltd in London. No ads, no streaks, no feed.">
  <PageHead eyebrow="About">Why Folio <em>exists.</em></PageHead>
  <div class="wrap"><article class="story">
    <p class="big serif" data-reveal>Diaries used to be private by default — a book in a drawer.</p>
    <p data-reveal>Apps made them convenient, then made them into products: streaks to chase, feeds to fill, and servers that can read every word. Somewhere along the way, the diary stopped being yours.</p>
    <p data-reveal>Folio goes back to the drawer and keeps the convenience. A calendar you already understand. Photos on the days they belong to. Tasks that stay where they happened. And encryption, so the drawer has a lock only you hold.</p>
    <p class="big serif" data-reveal>It should still be there in twenty years — and still be only yours.</p>
  </article></div>
  <section class="wrap wont" aria-labelledby="wont-h">
    <h2 id="wont-h">What we won’t do</h2>
    <ul>{wont.map((w) => <li class="serif">{w}</li>)}</ul>
  </section>
  <section class="wrap who" aria-labelledby="who-h">
    <h2 id="who-h">Who makes it</h2>
    <p>{site.company.name}, a small company registered in England and Wales (no. {site.company.number}), at {site.company.office}. The code is open source on <a href={site.githubUrl} rel="noopener">GitHub</a>.</p>
    <p>Questions or ideas: <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>. A person reads every message.</p>
  </section>
</Base>

<style>
  .story { max-width: 820px; padding-top: 8px; }
  .story p { font-size: clamp(18px, 1.9vw, 21px); color: var(--text-2); max-width: 58ch; }
  .story .big { font-size: clamp(32px, 4.2vw, 52px); line-height: 1.08; color: var(--ink); letter-spacing: -0.02em; margin: 40px 0 28px; max-width: 22ch; }
  .wont, .who { padding-top: clamp(64px, 8vw, 104px); }
  .wont h2, .who h2 { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-2); margin: 0 0 20px; }
  .wont ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hairline); }
  .wont li { font-size: clamp(30px, 4.4vw, 56px); line-height: 1.1; padding: 16px 0; border-bottom: 1px solid var(--hairline); letter-spacing: -0.02em; }
  .wont li::before { content: '×'; color: var(--ember-text); margin-right: 0.4em; font-family: var(--sans); font-size: 0.6em; vertical-align: 0.15em; }
  .who p { max-width: 60ch; font-size: 18px; color: var(--text-2); }
  .who a { color: var(--ink); text-decoration-color: var(--ember); text-underline-offset: 3px; }
</style>
