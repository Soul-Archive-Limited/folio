---
// The web app (SPEC §11.3). One page; /app/* is rewritten here (public/_redirects) and the
// React app routes itself. Not indexed (robots.txt, X-Robots-Tag).
import '../app/app.css';
import AppRoot from '../app/ui/AppRoot.tsx';
import Mark from '../components/Mark.astro';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Folio</title>
    <meta name="description" content="Your Folio diary in the browser, encrypted so only you can read it." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f6f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141418" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Folio" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <script is:inline>try{var d=document.documentElement,t=localStorage.getItem('folio.theme');if(t)d.dataset.theme=t;if(localStorage.getItem('folio.signedIn')==='1')d.dataset.session=''}catch(e){}</script>
  </head>
  <body>
    <AppRoot client:only="react">
      <!-- Batch L: the first paint is the gate itself (no full-screen splash); React replaces it in place. -->
      <main class="gate boot" slot="fallback" aria-busy="true">
        <div class="aura" aria-hidden="true"><i></i><i></i><i></i></div>
        <a class="gate-home" href="/"><Mark />Folio</a>
        <section class="gate-card glass">
          <Mark />
          <h1>Your days, kept.</h1>
          <p class="sub when-guest">Sign in to read and write your diary in the browser. It's encrypted so only you can read it.</p>
          <p class="loading-line" role="status"><span class="spinner" aria-hidden="true"></span><span class="when-session">Opening your diary…</span><span class="when-guest sr-only">Loading sign-in</span></p>
        </section>
        <p class="gate-foot"><a href="/security">How your privacy works</a> · <a href="/support">Help</a></p>
        <div class="launch" aria-hidden="true"><Mark /></div>
      </main>
    </AppRoot>
  </body>
</html>
