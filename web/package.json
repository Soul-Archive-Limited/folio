{
  "name": "folio-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Folio website (SPEC \u00a711). Astro static site with React islands, deployed on Cloudflare Pages.",
  "scripts": {
    "dev": "node scripts/tokens.mjs && astro dev",
    "build": "node scripts/tokens.mjs && astro build && node scripts/postbuild-headers.mjs",
    "preview": "astro preview",
    "test": "npm run typecheck && npm run test:unit && npm run build && node scripts/check-build.mjs",
    "test:unit": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "astro": "7.3.8",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
