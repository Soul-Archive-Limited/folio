{
  "name": "folio-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Folio website (SPEC §11). Astro static site with React islands, deployed on Cloudflare Pages.",
  "scripts": {
    "dev": "node scripts/tokens.mjs && astro dev",
    "build": "node scripts/tokens.mjs && astro build && node scripts/postbuild-headers.mjs",
    "preview": "astro preview",
    "test": "npm run typecheck && npm run test:unit && npm run build && node scripts/check-build.mjs",
    "test:unit": "node --test test/*.test.ts",
    "typecheck": "astro sync && tsc --noEmit -p ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "3.7.4",
    "@react-three/fiber": "9.8.2",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "astro": "7.4.5",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "7.0.2"
  }
}
