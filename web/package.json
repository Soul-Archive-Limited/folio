    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
