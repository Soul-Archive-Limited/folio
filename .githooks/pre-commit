#!/bin/sh
# Blocks any commit that contains a secret (SPEC §13.5).
# Enabled by scripts/setup-hooks.sh (git config core.hooksPath .githooks).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed. Install it with: brew install gitleaks" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
status=$?
if [ $status -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: commit blocked — gitleaks found a secret in the staged changes." >&2
  echo "Remove it from the files (and rotate it if it was real), then commit again." >&2
fi
exit $status
